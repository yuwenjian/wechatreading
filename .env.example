# 微信读书数据应用 · 环境变量样例
#
# 本地开发：复制为 .env.local 并填入真实值（.env.local 已被 .gitignore 忽略）
# Vercel 部署：在 Project Settings → Environment Variables 里逐条添加
#
# 重要：带 VITE_ 前缀的变量会打包进前端，只放"公开"值。
#       其余变量只在服务端函数中读取，绝不要加 VITE_ 前缀。

# ── 服务端专用（不暴露给浏览器）────────────────────────────────

# 微信读书 Agent Gateway 的 API Key，格式 wrk-xxxxxxxx
# 建议：本地与线上使用不同的 Key，线上泄露时只需吊销线上那一个
WEREAD_API_KEY=

# Supabase 项目地址，Dashboard → Settings → API → Project URL
SUPABASE_URL=

# Supabase service_role key。权限极高，可绕过 RLS，仅限服务端使用
SUPABASE_SERVICE_ROLE_KEY=

# 单用户白名单：只允许这个 Supabase 用户 id 读取数据（可留空，留空则不校验）
# 获取方式：登录一次后在 Supabase → Authentication → Users 里复制你的 User UID
ALLOWED_USER_ID=

# ── AI 分析（可选）──────────────────────────────────────────────
# 不填 OPENAI_API_KEY 就是"未启用"：/api/analysis/run 会返回 enabled:false，
# 只列出待分析书目，不调用任何模型、不改动任何数据。
#
# 协议是「OpenAI 兼容」的 /chat/completions，常见服务商填法：
#   OpenAI    OPENAI_BASE_URL=https://api.openai.com/v1        OPENAI_MODEL=gpt-4o-mini
#   DeepSeek  OPENAI_BASE_URL=https://api.deepseek.com/v1      OPENAI_MODEL=deepseek-chat
#   通义千问   OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#                                                              OPENAI_MODEL=qwen-plus
#   智谱       OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#                                                              OPENAI_MODEL=glm-4-flash
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# 显式开关。留空 = 有 Key 就启用；填 none = 即使有 Key 也强制关闭
ANALYSIS_PROVIDER=

# ── 前端可用（会打包进浏览器，受 RLS 约束）────────────────────

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── 登录方式（固定账号 + 密码）───────────────────────────────────
# 不依赖邮件：不发验证码、不点链接。密码用 `npm run set-password` 设置。
# 固定账号：配了它，登录页只要求输入密码；留空则页面显示邮箱输入框
VITE_LOGIN_EMAIL=you@example.com
